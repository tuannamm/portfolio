---
import { useTranslations, type Lang } from '../../i18n/ui';
import { posts } from '../../data/posts';
import { formatDate } from '../../lib/format';
import SectionHeading from '../ui/SectionHeading.astro';
import Card from '../ui/Card.astro';
import Reveal from '../home/Reveal.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
---
<section id="blog" class="section border-y border-line bg-surface/50" aria-labelledby="blog-title">
  <div class="container-page">
    <Reveal><SectionHeading id="blog-title" title={t('blog.title')} subtitle={t('blog.subtitle')} /></Reveal>
    <ul class="grid gap-4 md:grid-cols-3" role="list">
      {posts.map((p, i) => <Reveal as="li" delay={i * 70} class="h-full"><Card class="flex h-full flex-col bg-bg transition-colors hover:border-accent/50">
        <p class="text-sm text-muted"><time datetime={p.date}>{formatDate(p.date, lang)}</time> · {p.readMinutes} {t('blog.minRead')}</p>
        <h3 class="mt-4 text-lg font-semibold leading-snug">{p.title[lang]}</h3>
        <p class="mt-3 flex-1 leading-relaxed text-muted">{p.excerpt[lang]}</p>
        <a href={p.url} target="_blank" rel="noopener noreferrer" class="mt-6 self-start text-sm font-semibold text-accent hover:underline">{t('blog.readMore')} <span aria-hidden="true">↗</span></a>
      </Card></Reveal>)}
    </ul>
  </div>
</section>

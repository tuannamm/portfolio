---
import { useTranslations, type Lang } from '../../i18n/ui';
import { profile } from '../../data/profile';
import Button from '../ui/Button.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="hero" class="section pt-24 sm:pt-32" aria-labelledby="hero-title">
  <div class="container-page">
    <p class="mb-4 text-sm font-medium text-accent">{t('hero.greeting')}</p>
    <h1 id="hero-title" class="text-4xl font-bold tracking-tight sm:text-6xl">{profile.name}</h1>
    <p class="mt-3 text-xl font-medium text-muted sm:text-2xl">{profile.role[lang]}</p>
    <p class="mt-6 max-w-2xl text-lg text-muted">{profile.tagline[lang]}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <Button href="#projects">{t('hero.cta.projects')}</Button>
      <Button href={profile.cvUrl} variant="secondary" download>{t('hero.cta.cv')}</Button>
      <Button href="#contact" variant="ghost">{t('hero.cta.contact')}</Button>
    </div>
  </div>
</section>

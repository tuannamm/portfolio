---
import { useTranslations, type Lang } from '../../i18n/ui';
import { profile } from '../../data/profile';
import Button from '../ui/Button.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
// Set to '/avatar.jpg' after adding your portrait to public/.
const avatar: string | null = null;
---
<section id="hero" class="section" aria-labelledby="hero-title">
  <div class="container-page hero-content">
    <div class="portrait">
      {avatar ? <img src={avatar} alt={profile.name[lang]} width="400" height="400" /> : <span aria-hidden="true">{profile.initials}</span>}
    </div>
    <div class="hero-text">
      <p class="eyebrow font-semibold">{t('hero.greeting')}</p>
      <h1 id="hero-title" class="title">{profile.name[lang]}</h1>
      <p class="role">{profile.role[lang]}</p>
      <div class="actions">
        <Button href={profile.cvUrl} variant="outline" download>{t('hero.cta.cv')}</Button>
        <Button href="#contact" variant="filled">{t('hero.cta.contact')}</Button>
      </div>
      <div class="socials">
          <a href={profile.socials.github} class="social-link" target="_blank" rel="noopener noreferrer" aria-label={t('hero.github')}>
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true"><path d="M12 .5A11.5 11.5 0 0 0 8.36 22.9c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.7 1.25 3.35.96.1-.74.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.18 1.83 1.18 3.09 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg>
          </a>
          <a href={profile.socials.linkedin} class="social-link" target="_blank" rel="noopener noreferrer" aria-label={t('hero.linkedin')}>
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"/></svg>
          </a>
      </div>
    </div>
  </div>
</section>
<style>
  #hero { min-height: 80vh; display: flex; align-items: center; }
  @media (min-width: 75rem) { #hero { min-height: calc(100vh - 7rem); } }
  .hero-content { width: 100%; display: flex; align-items: center; justify-content: center; gap: 5rem; padding-block: 2rem; }
  .portrait { width: 400px; height: 400px; flex-shrink: 0; border-radius: 50%; background: var(--c-surface); border: 1px solid var(--c-line); display: grid; place-items: center; overflow: hidden; }
  .portrait span { font-size: 6rem; font-weight: 600; color: var(--c-muted); }
  .portrait img { width: 100%; height: 100%; object-fit: cover; }
  #hero-title { text-wrap: balance; line-height: 1.35; }
  .hero-text { text-align: center; max-width: 35rem; min-width: 0; }
  .role { font-size: 1.75rem; font-weight: 600; margin: 0.75rem 0 1rem; }
  .actions, .socials { display: flex; justify-content: center; flex-wrap: wrap; gap: 1rem; }
  .socials { margin-top: 1rem; }
  .social-link { display: inline-flex; width: 2rem; height: 2rem; }
  .social-link :global(svg) { width: 2rem; height: 2rem; }
  @media (max-width: 1199px) { .hero-content { flex-direction: column; gap: 2rem; } .portrait { width: 275px; height: 275px; } }
  @media (max-width: 600px) { .portrait { width: 46vw; height: 46vw; } .portrait span { font-size: 3.5rem; } .role { font-size: 1.25rem; } }
</style>

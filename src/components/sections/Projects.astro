---
import { useTranslations, type Lang } from '../../i18n/ui';
import { projects } from '../../data/projects';
import SectionHeading from '../ui/SectionHeading.astro';
import Card from '../ui/Card.astro';
import Tag from '../ui/Tag.astro';
import Reveal from '../home/Reveal.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const linkClass = 'inline-flex items-center gap-1 text-sm font-semibold text-accent transition-opacity hover:opacity-70';
---
<section id="projects" class="section border-y border-line bg-surface/50" aria-labelledby="projects-title">
  <div class="container-page">
    <Reveal><SectionHeading id="projects-title" title={t('projects.title')} subtitle={t('projects.subtitle')} /></Reveal>
    <ul class="grid gap-5 md:grid-cols-2" role="list">
      {projects.map((p, i) => (
        <Reveal as="li" delay={(i % 2) * 70} class:list={[i === 0 && 'md:col-span-2', 'h-full']}>
          <Card class:list={['group h-full overflow-hidden !p-0 transition-colors hover:border-accent/50', i === 0 && 'md:grid md:grid-cols-2']}>
            <div class="overflow-hidden bg-accent-soft">
              <img src={p.image} alt="" width="640" height="360" loading="lazy" class="aspect-video h-full w-full object-cover motion-safe:transition-transform motion-safe:duration-500 motion-safe:group-hover:scale-[1.03]" />
            </div>
            <div class="flex flex-col p-6 sm:p-7">
              <h3 class="text-xl font-semibold tracking-tight">{p.title}</h3>
              <p class="mt-3 flex-1 leading-relaxed text-muted">{p.description[lang]}</p>
              <ul class="mt-5 flex flex-wrap gap-2" role="list">{p.tech.map((x) => <li><Tag>{x}</Tag></li>)}</ul>
              <div class="mt-6 flex flex-wrap gap-x-5 gap-y-3">
                {p.github && <a href={p.github} target="_blank" rel="noopener noreferrer" class={linkClass}>{t('projects.source')} <span aria-hidden="true">↗</span></a>}
                {p.demo && <a href={p.demo} target="_blank" rel="noopener noreferrer" class={linkClass}>{t('projects.demo')} <span aria-hidden="true">↗</span></a>}
              </div>
            </div>
          </Card>
        </Reveal>
      ))}
    </ul>
  </div>
</section>

---
import { useTranslations, type Lang } from '../../i18n/ui';
import { projects } from '../../data/projects';
import SectionHeading from '../ui/SectionHeading.astro';
import Card from '../ui/Card.astro';
import Tag from '../ui/Tag.astro';
import Button from '../ui/Button.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="projects" class="section" aria-labelledby="projects-title">
  <div class="container-page">
    <SectionHeading id="projects-title" eyebrow={t('projects.eyebrow')} title={t('projects.title')} />
    <ul class="grid grid-cols-1 gap-8 md:grid-cols-2 desk:grid-cols-3" role="list">
      {projects.map((p) => (
        <Card as="li" variant="color" class="flex h-full flex-col items-center hover:border-line-strong">
          <img
            src={p.image}
            alt=""
            width="640"
            height="360"
            loading="lazy"
            class="mx-auto aspect-video w-[90%] rounded-[2rem] object-cover"
          />
          <h3 class="my-4 text-2xl font-semibold text-fg">{p.title}</h3>
          <p class="flex-1 text-sm leading-relaxed text-muted">{p.description[lang]}</p>
          <ul class="mt-4 flex flex-wrap justify-center gap-2" role="list">
            {p.tech.map((x) => <li><Tag>{x}</Tag></li>)}
          </ul>
          <div class="mt-6 flex flex-wrap justify-center gap-4">
            {p.github && <Button href={p.github} variant="project" external>{t('projects.source')}</Button>}
            {p.demo && <Button href={p.demo} variant="project" external>{t('projects.demo')}</Button>}
          </div>
        </Card>
      ))}
    </ul>
  </div>
</section>

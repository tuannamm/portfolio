---
import { useTranslations, type Lang } from '../../i18n/ui';
import { experience } from '../../data/experience';
import { formatMonth } from '../../lib/format';
import SectionHeading from '../ui/SectionHeading.astro';
import Card from '../ui/Card.astro';
import Tag from '../ui/Tag.astro';
import OrgLogo from '../ui/OrgLogo.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="experience" class="section" aria-labelledby="experience-title">
  <div class="container-page">
    <SectionHeading id="experience-title" eyebrow={t('experience.eyebrow')} title={t('experience.title')} />
    <!-- Vertical timeline: line + dots on the left, newest job first (data order). -->
    <ol
      class="relative space-y-8 pl-9 before:absolute before:bottom-2 before:left-[7px] before:top-2 before:w-px before:bg-line sm:pl-12"
      role="list"
    >
      {experience.map((job) => (
        <li class="relative">
          <span
            class="absolute -left-9 top-6 h-[15px] w-[15px] rounded-full bg-accent ring-4 ring-bg sm:-left-12"
            aria-hidden="true"
          ></span>
          <Card variant="details" class="text-left">
            <div class="flex flex-wrap items-start justify-between gap-x-6 gap-y-3">
              <div class="flex min-w-0 items-start gap-4">
                <OrgLogo logo={job.logo} name={job.company} />
                <div class="min-w-0">
                  <h3 class="text-xl font-semibold text-fg">{job.role[lang]}</h3>
                  <p class="mt-1 font-semibold text-muted">
                    {job.company} {job.location && <span class="font-normal">· {job.location[lang]}</span>}
                  </p>
                </div>
              </div>
              <p class="shrink-0 whitespace-nowrap rounded-full border border-line px-3 py-1 text-sm font-medium text-muted">
                <time datetime={job.start}>{formatMonth(job.start, lang)}</time> –{' '}
                {job.end ? <time datetime={job.end}>{formatMonth(job.end, lang)}</time> : t('experience.present')}
              </p>
            </div>
            <ul class="mt-4 max-w-3xl list-disc space-y-2 pl-5 leading-relaxed text-muted">
              {job.bullets.map((b) => <li>{b[lang]}</li>)}
            </ul>
            <ul class="mt-5 flex flex-wrap gap-2" role="list">
              {job.tech.map((x) => <li><Tag>{x}</Tag></li>)}
            </ul>
          </Card>
        </li>
      ))}
    </ol>
  </div>
</section>

---
import { useTranslations, type Lang } from '../../i18n/ui';
import { experience } from '../../data/experience';
import { formatMonth } from '../../lib/format';
import SectionHeading from '../ui/SectionHeading.astro';
import Card from '../ui/Card.astro';
import Tag from '../ui/Tag.astro';
import OrgLogo from '../ui/OrgLogo.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="experience" class="section" aria-labelledby="experience-title">
  <div class="container-page">
    <SectionHeading id="experience-title" eyebrow={t('experience.eyebrow')} title={t('experience.title')} />
    <!-- Vertical timeline: line + dots on the left, newest job first (data order). -->
    <ol
      class="relative space-y-8 pl-9 before:absolute before:bottom-2 before:left-[7px] before:top-2 before:w-px before:bg-line sm:pl-12"
      role="list"
    >
      {experience.map((job) => (
        <li class="relative">
          <span
            class="absolute -left-9 top-6 h-[15px] w-[15px] rounded-full bg-accent ring-4 ring-bg sm:-left-12"
            aria-hidden="true"
          ></span>
          <Card variant="details" class="job-card text-left">
            <div class="job-content">
              <div class="job-meta">
                <OrgLogo logo={job.logo} name={job.company} />
                <div class="job-meta-details">
                  <p class="font-semibold text-fg">{job.company}</p>
                  <p class="text-sm text-muted">
                    <time class="whitespace-nowrap" datetime={job.start}>{formatMonth(job.start, lang)}</time> –{' '}
                    {job.end ? (
                      <time class="whitespace-nowrap" datetime={job.end}>{formatMonth(job.end, lang)}</time>
                    ) : (
                      <span class="whitespace-nowrap">{t('experience.present')}</span>
                    )}
                  </p>
                  {job.location && <p class="text-sm text-muted">{job.location[lang]}</p>}
                </div>
              </div>
              <div class="job-details">
                <h3 class="text-xl font-semibold text-fg">{job.role[lang]}</h3>
                <ul class="job-bullets mt-4 list-disc space-y-2 pl-5 leading-relaxed text-muted">
                  {job.bullets.map((b) => <li>{b[lang]}</li>)}
                </ul>
                <ul class="mt-5 flex flex-wrap gap-2" role="list">
                  {job.tech.map((x) => <li><Tag>{x}</Tag></li>)}
                </ul>
              </div>
            </div>
          </Card>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .job-content { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.5rem; }
  .job-meta { display: flex; align-items: flex-start; gap: 0.75rem; min-width: 0; }
  .job-meta-details { display: grid; gap: 0.75rem; min-width: 0; }
  .job-details { min-width: 0; }
  @media (min-width: 768px) {
    .job-content { grid-template-columns: 13.75rem minmax(0, 1fr); gap: 2rem; }
    .job-meta { flex-direction: column; }
  }
</style>

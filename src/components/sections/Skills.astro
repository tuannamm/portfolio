---
import { useTranslations, type Lang, type UIKey } from '../../i18n/ui';
import { skills, getSkillIcon } from '../../data/skills';
import SectionHeading from '../ui/SectionHeading.astro';
import Card from '../ui/Card.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
// Short display labels for names that would wrap to 3 lines; full name stays in title/aria.
const shortLabels: Record<string, string> = {
  'Domain-Driven Design (DDD)': 'DDD',
  'Event-Driven Architecture': 'Event-Driven',
};
---
<section id="skills" class="section" aria-labelledby="skills-title">
  <div class="container-page">
    <SectionHeading id="skills-title" eyebrow={t('skills.eyebrow')} title={t('skills.title')} />
    <div class="skill-groups">
      {skills.map((group) => <Card as="article" class="skill-card hover:border-line-strong">
        <h3 class="skill-group-title">{t(`skills.${group.id}` as UIKey)}</h3>
        <ul class="skill-items" role="list">
          {group.items.map((skill) => {
            const icon = getSkillIcon(skill);
            const short = shortLabels[skill];
            return <li title={short ? skill : undefined} style={`--brand-color:${icon.color};--brand-dark-color:${icon.darkColor}`}>
              <svg viewBox={icon.viewBox} aria-hidden="true" fill="currentColor" set:html={icon.body} />
              {short ? <><span aria-hidden="true">{short}</span><span class="sr-only">{skill}</span></> : <span>{skill}</span>}
            </li>;
          })}
        </ul>
      </Card>)}
    </div>
  </div>
</section>
<style>
  .skill-groups {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 768px) {
    .skill-groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
    }
  }
  @media (min-width: 1200px) {
    .skill-groups {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-items: stretch;
    }
  }
  .skill-groups > :global(.skill-card) {
    text-align: left;
  }
  @media (max-width: 767px) {
    .skill-groups > :global(.skill-card) {
      padding: 1.25rem;
    }
  }
  .skill-group-title {
    color: var(--c-muted);
    font-weight: 600;
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 1.25rem;
  }
  .skill-items {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(6.25rem, 1fr));
    gap: 1.25rem 0.5rem;
  }
  @media (min-width: 1200px) {
    .skill-items {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: 1.5rem;
    }
  }
  .skill-items li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 0.25rem;
    border-radius: 0.875rem;
    text-align: center;
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.3;
    color: var(--c-fg);
    overflow-wrap: normal;
    word-break: normal;
    hyphens: none;
    transition: background-color 300ms ease;
  }
  .skill-items li:hover {
    background-color: var(--c-accent-soft);
  }
  .skill-items svg {
    width: 2.25rem;
    height: 2.25rem;
    flex-shrink: 0;
    color: currentColor;
    transition: color 300ms ease;
  }
  .skill-items li:hover svg {
    color: var(--brand-color);
  }
  :global(.dark) .skill-items li:hover svg {
    color: var(--brand-dark-color);
  }
</style>

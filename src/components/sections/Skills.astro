---
import { useTranslations, type Lang, type UIKey } from '../../i18n/ui';
import { skills, getSkillIcon } from '../../data/skills';
import SectionHeading from '../ui/SectionHeading.astro';
import Card from '../ui/Card.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
---
<section id="skills" class="section" aria-labelledby="skills-title">
  <div class="container-page">
    <SectionHeading id="skills-title" eyebrow={t('skills.eyebrow')} title={t('skills.title')} />
    <div class="skill-groups">
      {skills.map((group) => <Card as="article" class="hover:border-line-strong">
        <h3 class="experience-sub-title">{t(`skills.${group.id}` as UIKey)}</h3>
        <ul class="skill-items" role="list">
          {group.items.map((skill) => {
            const icon = getSkillIcon(skill);
            return <li style={`--brand-color:${icon.color};--brand-dark-color:${icon.darkColor}`}>
              <svg class="icon text-fg" viewBox={icon.viewBox} aria-hidden="true" fill="currentColor" set:html={icon.body} />
              <h4>{skill}</h4>
            </li>;
          })}
        </ul>
      </Card>)}
    </div>
  </div>
</section>
<style>
  .skill-groups { columns: 2; column-gap: 2rem; padding-bottom: 2rem; }
  .skill-groups > :global(article) { break-inside: avoid; margin-bottom: 2rem; }
  .experience-sub-title { color: var(--c-muted); font-weight: 600; font-size: 1.75rem; margin-bottom: 2rem; }
  .skill-items { display: flex; flex-wrap: wrap; gap: 2.5rem; justify-content: space-around; }
  .skill-items li { display: flex; gap: 0.5rem; align-items: center; width: 12rem; min-width: min-content; flex-shrink: 0; text-align: left; }
  .skill-items svg { flex-shrink: 0; transition: color 300ms ease; }
  .skill-items li:hover svg { color: var(--brand-color); }
  :global(.dark) .skill-items li:hover svg { color: var(--brand-dark-color); }
  .skill-items h4 { min-width: min-content; overflow-wrap: normal; word-break: normal; }
  @media (max-width: 600px) { .skill-groups { columns: 1; } .skill-groups > :global(article) { margin-bottom: 1rem; } .experience-sub-title { font-size: 1.25rem; } .skill-items { gap: 2.5rem 1rem; } }
  @media (max-width: 599px) {
    .skill-groups > :global(article) { padding: 1.25rem; }
    .skill-items { display: grid; grid-template-columns: repeat(2, minmax(0, 10.5rem)); justify-content: center; justify-items: center; column-gap: 0.5rem; row-gap: 1.25rem; }
    .skill-items li { width: fit-content; max-width: 100%; min-width: 0; gap: 0.375rem; }
    .skill-items li:last-child:nth-child(odd) { grid-column: 1 / -1; max-width: 10.5rem; }
    .skill-items svg { width: 1.5rem; height: 1.5rem; }
    .skill-items h4 { font-size: 0.875rem; }
  }
  @media (min-width: 360px) and (max-width: 374px) { .skill-items { column-gap: 0; } }
  @media (max-width: 359px) { .skill-items { grid-template-columns: 1fr; } }
  @media (min-width: 600px) and (max-width: 1199px) {
    .skill-groups { columns: 1; }
    .skill-items { display: grid; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); column-gap: 0.75rem; row-gap: 1.25rem; }
    .skill-items li { width: auto; min-width: 0; }
    .skill-items svg { width: 1.5rem; height: 1.5rem; }
    .skill-items h4 { font-size: 0.9rem; }
  }
  @media (min-width: 1200px) and (max-width: 1439px) {
    .skill-items { display: grid; grid-template-columns: repeat(auto-fit, minmax(10.5rem, 1fr)); column-gap: 0.75rem; row-gap: 1.25rem; }
    .skill-items li { width: auto; min-width: 0; }
    .skill-items svg { width: 1.5rem; height: 1.5rem; }
    .skill-items h4 { font-size: 0.9rem; }
  }
</style>

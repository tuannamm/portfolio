---
import { useTranslations, type Lang, type UIKey } from '../../i18n/ui';
import { skills, getSkillIcon } from '../../data/skills';
import SectionHeading from '../ui/SectionHeading.astro';
import Card from '../ui/Card.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
---
<section id="skills" class="section" aria-labelledby="skills-title">
  <div class="container-page">
    <SectionHeading id="skills-title" eyebrow={t('skills.eyebrow')} title={t('skills.title')} />
    <div class="skill-groups">
      {skills.map((group) => <Card as="article" class="skill-card hover:border-line-strong">
        <h3 class="skill-group-title">{t(`skills.${group.id}` as UIKey)}</h3>
        <ul class="skill-items" role="list">
          {group.items.map((skill) => {
            const icon = getSkillIcon(skill);
            return <li style={`--brand-color:${icon.color};--brand-dark-color:${icon.darkColor}`}>
              <svg viewBox={icon.viewBox} aria-hidden="true" fill="currentColor" set:html={icon.body} />
              <span>{skill}</span>
            </li>;
          })}
        </ul>
      </Card>)}
    </div>
  </div>
</section>
<style>
  .skill-groups {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 768px) {
    .skill-groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .skill-groups > :global(.skill-card) {
    text-align: left;
  }
  @media (max-width: 767px) {
    .skill-groups > :global(.skill-card) {
      padding: 1.25rem;
    }
  }
  .skill-group-title {
    color: var(--c-muted);
    font-weight: 600;
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }
  .skill-items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .skill-items li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.8rem 0.4rem 0.55rem;
    border: 1px solid var(--c-line);
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 500;
    white-space: nowrap;
    color: var(--c-fg);
    transition: border-color 300ms ease;
  }
  .skill-items li:hover {
    border-color: var(--c-line-strong);
  }
  .skill-items svg {
    width: 1.125rem;
    height: 1.125rem;
    flex-shrink: 0;
    color: currentColor;
    transition: color 300ms ease;
  }
  .skill-items li:hover svg {
    color: var(--brand-color);
  }
  :global(.dark) .skill-items li:hover svg {
    color: var(--brand-dark-color);
  }
</style>

---
import { useTranslations, type Lang } from '../../i18n/ui';
import { profile } from '../../data/profile';
import { experience } from '../../data/experience';
import { education } from '../../data/education';
import SectionHeading from '../ui/SectionHeading.astro';
import Card from '../ui/Card.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const earliest = Math.min(...experience.map((job) => new Date(`${job.start}-01`).getTime()));
const years = Math.max(1, Math.floor((Date.now() - earliest) / (365.25 * 24 * 3600 * 1000)));
const companies = new Set(experience.map((job) => job.company)).size;
const initials = profile.name.split(' ').map((word) => word[0]).join('').slice(0, 2);
---
<section id="about" class="section" aria-labelledby="about-title">
  <div class="container-page">
    <SectionHeading id="about-title" eyebrow={t('about.eyebrow')} title={t('about.title')} />
    <div class="about-content">
      <div class="about-picture" aria-hidden="true">{initials}</div>
      <div class="about-details">
        <div class="facts">
          <Card>
            <svg class="icon mx-auto mb-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="7" width="18" height="14" rx="2"/><path d="M8 7V3h8v4M3 12c6 3 12 3 18 0M10 13h4"/></svg>
            <h3>{t('experience.title')}</h3>
            <p>{years}+ {t('about.facts.years')}</p>
            <p>{companies} {t('about.facts.companies')}</p>
          </Card>
          <Card>
            <svg class="icon mx-auto mb-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m2 8 10-5 10 5-10 5L2 8Zm4 2v7c4 3 8 3 12 0v-7M22 8v9"/></svg>
            <h3>{t('education.education')}</h3>
            {education.map((degree) => <p>{degree.degree[lang]}</p>)}
          </Card>
        </div>
        <div class="about-copy">{profile.about.map((paragraph) => <p>{paragraph[lang]}</p>)}</div>
        <p class="mt-4">{t('about.location')}: {profile.location[lang]}</p>
      </div>
    </div>
  </div>
</section>
<style>
  .about-content { display: flex; align-items: center; gap: 4rem; padding-block: 2rem; }
  .about-picture { width: 400px; height: 400px; flex-shrink: 0; border-radius: 2rem; background: var(--c-surface); border: 0.1rem solid var(--c-line); display: grid; place-items: center; font-size: 6rem; font-weight: 600; color: var(--c-muted); }
  .about-details { flex: 1; min-width: 0; }
  .facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem; margin-bottom: 2rem; }
  .facts h3 { font-size: 1.17rem; }
  .about-copy { display: grid; gap: 1rem; line-height: 1.6; }
  @media (max-width: 1199px) { .about-content { flex-direction: column; gap: 2rem; } .about-picture { width: 275px; height: 275px; } }
  @media (max-width: 600px) { .about-picture { width: 65vw; height: 65vw; font-size: 4rem; } .facts { grid-template-columns: 1fr; gap: 1rem; } }
</style>

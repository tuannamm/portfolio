---
import { useTranslations, type Lang } from '../../i18n/ui';
import { profile } from '../../data/profile';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

const links = [
  { id: 'about', label: t('nav.about') },
  { id: 'skills', label: t('nav.skills') },
  { id: 'experience', label: t('nav.experience') },
  { id: 'projects', label: t('nav.projects') },
  { id: 'education', label: t('nav.education') },
  { id: 'contact', label: t('nav.contact') },
];
---

<footer class="container-page pb-10 pt-8">
  <nav aria-label={t('footer.nav')}>
    <ul class="flex flex-col items-center justify-center gap-2 text-base min-[600px]:flex-row min-[600px]:flex-wrap min-[600px]:gap-x-8 min-[600px]:gap-y-3 min-[600px]:text-xl desk:text-2xl">
      {links.map((l) => <li><a href={`#${l.id}`}>{l.label}</a></li>)}
    </ul>
  </nav>
  <p class="mt-8 text-center">© {new Date().getFullYear()} {profile.name}. {t('footer.rights')}</p>
</footer>

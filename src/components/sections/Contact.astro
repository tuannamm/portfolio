---
import { useTranslations, type Lang } from '../../i18n/ui';
import { profile } from '../../data/profile';
import SectionHeading from '../ui/SectionHeading.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="contact" class="section flex min-h-[70vh] flex-col justify-center" aria-labelledby="contact-title">
  <div class="container-page">
    <SectionHeading id="contact-title" eyebrow={t('contact.eyebrow')} title={t('contact.title')} />
    <div class="mx-auto my-8 flex w-fit max-w-full flex-wrap items-center justify-center rounded-[2rem] border-[0.1rem] border-line bg-bg p-2">
      <div class="m-4 flex items-center justify-center gap-2">
        <svg viewBox="0 0 24 24" class="h-10 w-10 shrink-0 text-fg" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2" y="4" width="20" height="16" rx="2" />
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
        </svg>
        <a href={`mailto:${profile.email}`} class="break-all text-lg text-fg [text-underline-offset:0.5rem]">
          {profile.email}
        </a>
      </div>

      <div class="m-4 flex items-center justify-center gap-2">
        <svg viewBox="0 0 24 24" class="icon shrink-0 text-fg" fill="currentColor" aria-hidden="true">
          <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z" />
        </svg>
        <a href={profile.socials.linkedin} target="_blank" rel="noopener noreferrer" class="text-lg text-fg [text-underline-offset:0.5rem]">
          {t('contact.linkedin')}
        </a>
      </div>

      <div class="m-4 flex items-center justify-center gap-2">
        <svg viewBox="0 0 24 24" class="icon shrink-0 text-fg" fill="currentColor" aria-hidden="true">
          <path d="M12 .5A11.5 11.5 0 0 0 8.36 22.9c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.7 1.25 3.35.96.1-.74.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.18 1.83 1.18 3.09 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z" />
        </svg>
        <a href={profile.socials.github} target="_blank" rel="noopener noreferrer" class="text-lg text-fg [text-underline-offset:0.5rem]">
          {t('contact.github')}
        </a>
      </div>
    </div>

    <div class="mt-2 flex justify-center">
      <button
        type="button"
        hidden
        data-copy-email={profile.email}
        data-copied={t('contact.copied')}
        class="btn btn-outline"
      >
        {t('contact.copyEmail')}
      </button>
      <span data-copy-status class="sr-only" role="status" aria-live="polite"></span>
    </div>
  </div>
</section>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-copy-email]');
  const status = document.querySelector<HTMLElement>('[data-copy-status]');
  if (button && navigator.clipboard?.writeText) {
    button.hidden = false;
    const original = button.textContent;
    let timer: ReturnType<typeof setTimeout>;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copyEmail ?? '');
        button.textContent = button.dataset.copied ?? '';
        if (status) status.textContent = button.dataset.copied ?? '';
        clearTimeout(timer);
        timer = setTimeout(() => { button.textContent = original; if (status) status.textContent = ''; }, 2000);
      } catch { /* The email remains available as text and a mailto link. */ }
    });
  }
</script>

---
import { useTranslations, type Lang } from '../../i18n/ui';
import { profile } from '../../data/profile';
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import Reveal from '../home/Reveal.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
---
<section id="contact" class="section border-t border-line" aria-labelledby="contact-title">
  <div class="container-page">
    <Reveal><div class="rounded-2xl border border-line bg-surface p-6 sm:p-10 md:p-12">
      <SectionHeading id="contact-title" title={t('contact.title')} subtitle={t('contact.subtitle')} />
      <p class="max-w-2xl leading-relaxed text-muted">{t('contact.copy')}</p>
      <p class="mt-6 break-all text-lg font-semibold">{profile.email}</p>
      <div class="mt-5 flex flex-wrap items-center gap-3">
        <Button href={`mailto:${profile.email}`}>{t('contact.email')} <span aria-hidden="true">↗</span></Button>
        <button type="button" hidden data-copy-email={profile.email} data-copied={t('contact.copied')} class="rounded-lg border border-line bg-bg px-4 py-2.5 text-sm font-semibold transition-colors hover:bg-accent-soft">{t('contact.copyEmail')}</button>
        <span data-copy-status class="sr-only" role="status" aria-live="polite"></span>
      </div>
      <div class="mt-8 flex flex-wrap gap-5 text-sm font-semibold">
        <a href={profile.socials.github} target="_blank" rel="noopener noreferrer" class="text-muted hover:text-accent">{t('contact.github')} <span aria-hidden="true">↗</span></a>
        <a href={profile.socials.linkedin} target="_blank" rel="noopener noreferrer" class="text-muted hover:text-accent">{t('contact.linkedin')} <span aria-hidden="true">↗</span></a>
      </div>
    </div></Reveal>
  </div>
</section>
<script>
  const button = document.querySelector<HTMLButtonElement>('[data-copy-email]');
  const status = document.querySelector<HTMLElement>('[data-copy-status]');
  if (button && navigator.clipboard?.writeText) {
    button.hidden = false;
    const original = button.textContent;
    let timer: ReturnType<typeof setTimeout>;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copyEmail ?? '');
        button.textContent = button.dataset.copied ?? '';
        if (status) status.textContent = button.dataset.copied ?? '';
        clearTimeout(timer);
        timer = setTimeout(() => { button.textContent = original; if (status) status.textContent = ''; }, 2000);
      } catch { /* The email remains available as text and a mailto link. */ }
    });
  }
</script>

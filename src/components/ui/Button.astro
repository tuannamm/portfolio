---
interface Props {
  href: string;
  variant?: 'filled' | 'outline' | 'project';
  external?: boolean;
  download?: boolean | string;
  class?: string;
}
const { href, variant = 'filled', external = false, download = false, class: className = '' } = Astro.props;
---

<a
  href={href}
  class:list={['btn', `btn-${variant}`, className]}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  download={download === true ? '' : download || undefined}
>
  <slot />
</a>

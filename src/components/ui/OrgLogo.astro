---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  logo?: ImageMetadata;
  name: string;
  size?: 'md' | 'lg';
  class?: string;
}

const { logo, name, size = 'md', class: className = '' } = Astro.props;
const parts = name.split(/[\s-]+/).filter(Boolean);
const initials =
  parts.length >= 2
    ? `${parts[0][0]}${parts[1][0]}`.toUpperCase()
    : name.slice(0, 2).toUpperCase();

const targetPx = 192;
const isSvg = logo?.format === 'svg';
const imgWidth = logo ? Math.min(targetPx, logo.width) : targetPx;
const imgHeight = logo ? Math.round((imgWidth * logo.height) / logo.width) : targetPx;
---

<span
  class:list={[
    'org-logo',
    size === 'lg' ? 'org-logo-lg' : 'org-logo-md',
    logo ? 'org-logo-img' : 'org-logo-fallback',
    className,
  ]}
>
  {logo ? (
    <Image
      src={logo}
      alt={name}
      width={imgWidth}
      height={imgHeight}
      format={isSvg ? 'svg' : 'webp'}
      quality={isSvg ? undefined : 90}
      loading="lazy"
      decoding="async"
    />
  ) : (
    <span aria-hidden="true">{initials}</span>
  )}
</span>

<style>
  .org-logo {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    border-radius: 1rem;
    padding: 0.5rem;
    overflow: hidden;
  }
  .org-logo-md {
    width: 4.5rem;
    height: 4.5rem;
  }
  @media (min-width: 768px) {
    .org-logo-md {
      width: 6rem;
      height: 6rem;
    }
  }
  .org-logo-lg {
    width: 6rem;
    height: 6rem;
  }
  .org-logo-img {
    background-color: #ffffff;
  }
  .org-logo-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .org-logo-fallback {
    background-color: var(--c-surface);
    color: var(--c-fg);
    font-weight: 600;
    font-size: 1.25rem;
    letter-spacing: 0.02em;
    line-height: 1;
  }
</style>

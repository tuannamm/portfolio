---
/**
 * variant: 'details' (default; white bg, centered) | 'color' (surface bg, project cards)
 * as: element tag. Extra classes via `class` (e.g. "text-left").
 */
interface Props {
  as?: 'div' | 'article' | 'li';
  variant?: 'details' | 'color';
  class?: string;
}
const { as: Tag = 'div', variant = 'details', class: className = '' } = Astro.props;
---

<Tag class:list={[variant === 'color' ? 'color-container' : 'details-container', className]}>
  <slot />
</Tag>

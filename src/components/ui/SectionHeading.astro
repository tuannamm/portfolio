---
/** Centered eyebrow above centered title. `subtitle` optional (centered, muted). */
interface Props {
  title: string;
  eyebrow?: string;
  subtitle?: string;
  id?: string;
  class?: string;
}
const { title, eyebrow, subtitle, id, class: className = '' } = Astro.props;
---

<div class:list={['mb-10', className]}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 id={id} class="title">{title}</h2>
  {subtitle && <p class="mx-auto mt-3 max-w-2xl text-center text-lg">{subtitle}</p>}
</div>

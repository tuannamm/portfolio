---
interface Props {
  title: string;
  subtitle?: string;
  id?: string;
}
const { title, subtitle, id } = Astro.props;
---

<div class="mb-10 max-w-2xl">
  <h2 id={id} class="text-3xl font-bold tracking-tight sm:text-4xl">{title}</h2>
  {subtitle && <p class="mt-3 text-lg text-muted">{subtitle}</p>}
</div>

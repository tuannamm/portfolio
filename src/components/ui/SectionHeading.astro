---
/** Centered eyebrow above centered title. */
interface Props {
  title: string;
  eyebrow?: string;
  id?: string;
  class?: string;
}
const { title, eyebrow, id, class: className = '' } = Astro.props;
---

<div class:list={['mb-10', className]}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 id={id} class="title">{title}</h2>
</div>

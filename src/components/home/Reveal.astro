---
// Subtle fade/slide-in on scroll. Respects prefers-reduced-motion (no hidden state at all).
interface Props { delay?: number; class?: string; as?: 'div' | 'li' | 'p' | 'span' }
const { delay = 0, class: className = '', as: Tag = 'div' } = Astro.props;
---

<Tag class:list={['reveal', className]} style={`--reveal-delay:${delay}ms`}><slot /></Tag>

<style is:global>
  @media (prefers-reduced-motion: no-preference) {
    html.js-reveal .reveal {
      opacity: 0;
      transform: translateY(14px);
      transition: opacity 0.6s ease-out, transform 0.6s ease-out;
      transition-delay: var(--reveal-delay, 0ms);
    }
    html.js-reveal .reveal.is-visible { opacity: 1; transform: none; }
  }
</style>

<script>
  // js-reveal is set by the inline script in BaseLayout <head> so hidden state applies from first paint.
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
      }),
      { threshold: 0.12, rootMargin: '0px 0px -40px 0px' },
    );
    document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
  }
</script>

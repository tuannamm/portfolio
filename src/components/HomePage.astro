---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from './Navbar.astro';
import Hero from './sections/Hero.astro';
import About from './sections/About.astro';
import Skills from './sections/Skills.astro';
import Experience from './sections/Experience.astro';
import Projects from './sections/Projects.astro';
import Education from './sections/Education.astro';
import Blog from './sections/Blog.astro';
import Contact from './sections/Contact.astro';
import Footer from './sections/Footer.astro';
import type { Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
---

<BaseLayout lang={lang}>
  <Navbar slot="header" lang={lang} />
  <Hero lang={lang} />
  <About lang={lang} />
  <Skills lang={lang} />
  <Experience lang={lang} />
  <Projects lang={lang} />
  <Education lang={lang} />
  <Blog lang={lang} />
  <Contact lang={lang} />
  <Footer slot="footer" lang={lang} />
</BaseLayout>
